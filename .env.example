# ---------- Database (Supabase Postgres) ----------
# Transaction pooler URL for the `sales_portal` role (see db/migrations/003_app_role.sql.template):
# postgresql://sales_portal.<project-ref>:<password>@aws-1-ap-south-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# ---------- App ----------
PORT=3000
# Public URL (on Vercel this defaults to the production domain automatically)
PUBLIC_URL=http://localhost:3000
# Long random strings — CHANGE IN PRODUCTION
JWT_SECRET=change-me-to-a-long-random-string
KIOSK_KEY=kiosk-demo-key
UNIT_HOLD_HOURS=48

# ---------- Organisation ----------
ORG_NAME=Mihir Group
ORG_WEBSITE=www.mihirgroup.com
ORG_TAGLINE=Live Beyond Time
# Official WhatsApp Business number, country code + number, no "+" (used in the kiosk QR)
ORG_WHATSAPP=919800000000

# ---------- WhatsApp Business (Meta Cloud API) ----------
# mock = log to the Outbox page only. cloud = send for real.
WA_MODE=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v20.0
WA_VERIFY_TOKEN=mihir-verify-token
WA_TPL_SALES_ALERT=new_walkin_alert
WA_TPL_REASSIGN=walkin_reassigned
WA_TPL_BOOKING_CONFIRMED=booking_confirmed
WA_TPL_LANG=en

# ---------- CRM (same Supabase database) ----------
# supabase = write walk-ins into public.enquiries · mock = log only
CRM_MODE=supabase

# ---------- Accounts (internal portal) ----------
INTERNAL_MODE=mock
INTERNAL_BASE_URL=
INTERNAL_API_KEY=
INTERNAL_WEBHOOK_SECRET=change-me
